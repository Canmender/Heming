{
  "name": "heming",
  "private": true,
  "version": "120.3.47",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "dist:desktop": "pnpm --filter @heming/desktop dist",
    "plugin:new": "node scripts/new-plugin.mjs",
    "plugin:lint": "node scripts/plugin-lint.mjs --dir plugins --skip examples,_template",
    "plugin:schema": "node scripts/plugin-schema.mjs",
    "plugin:check": "pnpm --filter @heming/shared build && node scripts/plugin-lint.mjs --dir plugins --skip examples,_template && node scripts/plugin-schema.mjs --check",
    "plugin:pack": "node scripts/pack-plugin.mjs",
    "plugin:publish": "node scripts/publish-plugin.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:show": "node scripts/version.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "hemingVersion": "d.120.3.47.0"
}
