{
  "schemaVersion": 4,
  "id": "heming.infohub-page",
  "name": "聊天记录",
  "version": "0.2.0",
  "description": "自带本机引擎的聊天记录插件：采集本机 QQ / 微信归档，左边选会话、右边看消息，支持搜索与向前翻页；可调用和鸣「后台任务模型」生成摘要，并自动存入和鸣内置知识库。装完即用，不依赖外部服务。",
  "author": "和鸣",
  "distribution": "bundle",
  "permissions": {
    "network": [],
    "tools": "none",
    "files": [],
    "events": ["theme"],
    "graphics": [],
    "eval": false,
    "chat": true,
    "kb": true
  },
  "contributions": {
    "page": {
      "title": "聊天记录",
      "icon": "message",
      "summary": "浏览本机归档的 QQ / 微信会话与消息，一键采集并按需存入和鸣知识库",
      "entry": "files/index.html"
    },
    "engine": {
      "entry": "files/engine/bridge.py",
      "lib": "files/engine/lib"
    }
  }
}