.superpowers/
node_modules/
dist/
release/
.env
.worktrees/
.claude/
packages/server/data/
data/

# electron-builder 误落在仓库根的产物目录
@hemingdesktop/

# 桌面端要嵌入的 web 产物（scripts/build-desktop-web.mjs 生成，打包时打进 resources/web）
packages/desktop/web-dist/

# 内置运行时（380MB：Python 3.12 + 200+ 个 MCP 服务包）
# 由 scripts/prepare-runtime.mjs 构建、scripts/build-desktop.mjs 打进安装包。
# 属于**本机构建产物**，不入版本库：
#   - 体积太大（单个 .pyc 就够撑爆仓库）
#   - 内容是第三方包，与源码无关，变了也不该产生 diff
# 需要重建时跑 prepare-runtime.mjs（见 docs/VERSION-MANAGEMENT.md）
packages/desktop/runtime/

# 本机项目记忆（WorkBuddy 的项目级日志，属机器本地状态）
.workbuddy/

# 临时脚本与缓存（截图、探测页、构建缓存）
.tmp/
.tmp-bench*/

# vite / vitest 运行时在包目录里留下的临时文件
*.timestamp-*.mjs
_tmp_*

# Python 字节码（InfoHub 随源码并入，但缓存不入库）
__pycache__/
*.pyc

# InfoHub 的本机配置与归档只属于设备，不进仓库
packages/infohub/config.json
packages/infohub/data/

# 内置 magpie CLI（约 70MB，构建时由 scripts/fetch-magpie.mjs 下载并校验；只留 .gitkeep）
packages/desktop/resources/magpie/magpie-core*
packages/desktop/resources/magpie/*.download

# 本机自检日志（不属于仓库内容）
d[0-9]*-selfcheck-*.log

# 云端插件仓库的发布产物（部署数据，不入库；由 scripts/publish-plugin.mjs 生成/同步）
plugins-catalog/

# magpie 内核源码（MIT，构建机本地放置；不入库）
# 原因：vendor 里含 Gemini CLI / Antigravity 随 CLI 分发的 OAuth client 凭据，
# GitHub 密钥扫描会把整条历史拦下；而它只是「编译 magpie-core.exe」的输入，不是运行时内容。
# 需要重建内核时：把上游裁剪后的源码放到 vendor/magpie-core/，再 `node scripts/build-magpie-core.mjs --force`。
vendor/magpie-core/

# 选装模块包（信息中枢引擎等）的构建输入与发布产物：依赖来自 PyPI，不入库
.tmp-engine-lib/
module-catalog/

# 模块引擎依赖下载与下载测试的临时产物
.tmp-engine-wheels/
.tmp-module-dl/

# tsc -b 的增量构建信息（每次 typecheck 都会重写，不入库）
*.tsbuildinfo

# 本地 UI 自检临时目录（Electron userData / 截图，不入库）
.ui-check-tmp/
# 跨语言联调测试的临时工作目录（进程退出后句柄可能还占着一小会儿）
.tmp-pipeline-live-*/
# 在仓库根跑 agent-pipeline 测试的产物（cwd 决定落地）
runs.jsonl
agent-pipeline.db
.coverage
pytest-of-*/
