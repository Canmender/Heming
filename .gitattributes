# docker 构建资产必须保持 LF：Dockerfile 的指令解析对行尾 \r 容错差，
# 而本仓库 Windows 侧 core.autocrlf=true（checkout 会把 LF 转成 CRLF）。
docker/** text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

# 裸机部署资产同理，而且后果更直接：bash 遇到 `set -o pipefail\r` 会当场语法错，
# systemd 遇到 `ExecStart=...\r` 会把 \r 当成参数的一部分。
deploy/** text eol=lf
